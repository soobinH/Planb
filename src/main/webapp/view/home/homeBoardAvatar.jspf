<%@ page pageEncoding="UTF-8" %>
<%-- 홈 여행꿀팁 / 여행메이트 미리보기 : 작성자 프로필
     - boardProfileImg, boardNickname 을 c:set 으로 지정한 뒤 include
     - https:// 주소 : 그대로 사용 (소셜 로그인 프로필)
     - / 로 시작   : 컨텍스트만 붙임
     - 파일명       : 공유 폴더(profilePath, /uploads/profile)에서 불러옴
     - 사진이 없거나 불러오지 못하면 닉네임 첫 글자 --%>
<c:set var="boardInitial" value="${empty boardNickname ? 'U' : fn:substring(boardNickname, 0, 1)}" />
<c:choose>
	<c:when test="${not empty boardProfileImg}">
		<c:choose>
			<c:when test="${fn:startsWith(boardProfileImg, 'http://') or fn:startsWith(boardProfileImg, 'https://')}">
				<c:set var="boardProfileSrc" value="${boardProfileImg}" />
			</c:when>
			<c:when test="${fn:startsWith(boardProfileImg, '/')}">
				<c:set var="boardProfileSrc" value="${ctx}${boardProfileImg}" />
			</c:when>
			<c:otherwise>
				<c:set var="boardProfileSrc" value="${ctx}${empty applicationScope.profilePath ? '/uploads/profile' : applicationScope.profilePath}/${boardProfileImg}" />
			</c:otherwise>
		</c:choose>
		<img class="ph-board-avatar-img" src="${fn:escapeXml(boardProfileSrc)}" alt="" loading="lazy" referrerpolicy="no-referrer"
			onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';">
		<span class="ph-avatar" style="display: none;"><c:out value="${boardInitial}" /></span>
	</c:when>
	<c:otherwise>
		<span class="ph-avatar"><c:out value="${boardInitial}" /></span>
	</c:otherwise>
</c:choose>
